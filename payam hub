    if AutoFlingAllEnabled then
        FlingAllToggleBtn.Text = "FLING ALL: ON"
        FlingAllToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 130, 80)
        SelectedTargets = {}
        for _, p in pairs(Players:GetPlayers()) do
