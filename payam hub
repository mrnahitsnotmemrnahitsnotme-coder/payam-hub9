Tabs.Fun = Window:AddTab({ Title = "Fun", Icon = "zap" })

local FunTimeStopSection = Tabs.Fun:AddSection("Time Stop")

do
    local TSPlayers = game:GetService("Players")
    local TSRun = game:GetService("RunService")
    local TSTween = game:GetService("TweenService")
    local TSLighting = game:GetService("Lighting")
    local TSDebris = game:GetService("Debris")
    local tsPlayer = TSPlayers.LocalPlayer
    local tsCamera = workspace.CurrentCamera

    local MAX_TIME_NORMAL = 30
    local MAX_TIME_PERFECT = 50
    local MAX_TIME_RANGE = 10
    local COOLDOWN_NORMAL = 5
    local COOLDOWN_RANGE = 30
    local COLOR_DELAY = 0.2
    local SPEED_MULT = 2
    local WARNING_DISPLAY_TIME = 2
    local ANIM_NORMAL = "rbxassetid://108059270529140"
    local ANIM_PERFECT = "rbxassetid://91674885900854"
    local ANIM_RANGE = "rbxassetid://83940178849662"
    local SOUND_NORMAL_ACT = 7514417921
    local SOUND_NORMAL_DEACT = 97139043906890
    local SOUND_PERFECT_ACT = 2553928644
    local SOUND_PERFECT_EXTRA = 5104670875
    local SOUND_PERFECT_DEACT = 97139043906890
    local SOUND_RANGE_ACT = 5104670875
    local SOUND_RANGE_LOOP = 130792013637723
    local SOUND_RANGE_DEACT = 97139043906890
    local SOUND_COOLDOWN = 1839847326

    local timeStopped = false
    local locked = false
    local startTime = 0
    local originalWalkSpeed
    local frozenParts = {}
    local colorEffect
    local fovTween
    local currentStopType = "Normal"
    local maxTime = MAX_TIME_NORMAL
    local rangeSoundInstance
    local cooldownSoundInstance
    local perfectExtraSoundInstance
    local normalSoundInstance
    local perfectSoundInstance
    local currentAnimTrack
    local vignetteGui
    local fixedCameraCFrame
    local rangeCameraCFrame

    -- dummy ScreenGui just for sphere VFX (no button)
    local tsGui = Instance.new("ScreenGui")
    tsGui.Name = "PayamTimeStopVFX"
    tsGui.ResetOnSpawn = false
    tsGui.Parent = game.CoreGui

    local function playSound(id, volume, looped)
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = volume or 1
        if looped then s.Looped = true end
        s.Parent = workspace
        s:Play()
        TSDebris:AddItem(s, looped and 50 or 6)
        return s
    end

    local function explosionParticles(c1, c2)
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 1
        part.Position = tsCamera.CFrame.Position
        part.Parent = workspace
        local p = Instance.new("ParticleEmitter")
        p.Texture = "rbxassetid://243660364"
        p.Color = ColorSequence.new{ ColorSequenceKeypoint.new(0,c1), ColorSequenceKeypoint.new(1,c2) }
        p.Size = NumberSequence.new{ NumberSequenceKeypoint.new(0,0.6), NumberSequenceKeypoint.new(1,0) }
        p.Lifetime = NumberRange.new(0.3)
        p.Speed = NumberRange.new(4)
        p.Rate = 0
        p:Emit(30)
        p.Parent = part
        TSDebris:AddItem(part, 1)
    end

    local function boostSpeed(enable)
        local char = tsPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if not originalWalkSpeed then originalWalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = enable and originalWalkSpeed * SPEED_MULT or originalWalkSpeed
    end

    local function zoomCam(fov, t)
        if fovTween then fovTween:Cancel() end
        fovTween = TSTween:Create(tsCamera, TweenInfo.new(t, Enum.EasingStyle.Quad), { FieldOfView = fov })
        fovTween:Play()
    end

    local function camShake(dur, mag)
        local s = tick()
        local orig = tsCamera.CFrame
        local c; c = TSRun.RenderStepped:Connect(function()
            if tick()-s > dur then tsCamera.CFrame = orig c:Disconnect() return end
            tsCamera.CFrame = orig * CFrame.new((math.random()-0.5)*mag,(math.random()-0.5)*mag,0)
        end)
    end

    local function camRangeEffect()
        local blur = Instance.new("BlurEffect")
        blur.Size = 8
        blur.Parent = TSLighting
        fixedCameraCFrame = tsCamera.CFrame
        local c; c = TSRun.RenderStepped:Connect(function()
            if not timeStopped or currentStopType ~= "Range" then
                blur:Destroy() c:Disconnect() return
            end
            tsCamera.CFrame = fixedCameraCFrame * CFrame.new(math.sin(tick()*2)*0.3, math.cos(tick()*2)*0.3, 0)
        end)
    end

    local function freezeWorld()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(tsPlayer.Character) then
                if not obj.Anchored then
                    frozenParts[obj] = true
                    obj.Anchored = true
                end
            end
        end
    end

    local function unfreezeWorld()
        for part in pairs(frozenParts) do
            if part and part.Parent then part.Anchored = false end
        end
        frozenParts = {}
    end

    local function makeSphere(color, trans, z)
        local s = Instance.new("Frame")
        s.AnchorPoint = Vector2.new(0.5,0.5)
        s.Position = UDim2.fromScale(0.5,0.5)
        s.Size = UDim2.fromOffset(0,0)
        s.BackgroundColor3 = color
        s.BackgroundTransparency = trans
        s.BorderSizePixel = 0
        s.ZIndex = z
        s.Parent = tsGui
        Instance.new("UICorner",s).CornerRadius = UDim.new(1,0)
        return s
    end

    local function activateVFX()
        colorEffect = Instance.new("ColorCorrectionEffect")
        colorEffect.Parent = TSLighting
        if currentStopType == "Normal" then
            colorEffect.Saturation = -1 colorEffect.Contrast = 1.2
            colorEffect.TintColor = Color3.fromRGB(200,200,220)
        elseif currentStopType == "Perfect" then
            colorEffect.Saturation = -0.5 colorEffect.Contrast = 1.5
            colorEffect.TintColor = Color3.fromRGB(255,240,180)
        elseif currentStopType == "Range" then
            colorEffect.Saturation = -1 colorEffect.Contrast = 2
            colorEffect.TintColor = Color3.fromRGB(0,255,255)
        end
        local function expand(col, trans, delay)
            task.wait(delay)
            local sp = makeSphere(col, trans, 20)
            TSTween:Create(sp, TweenInfo.new(0.4), { Size = UDim2.fromOffset(3000,3000) }):Play()
            TSDebris:AddItem(sp, 0.5)
        end
        expand(Color3.fromRGB(140,0,255), 0.45, 0)
        expand(Color3.fromRGB(255,140,0), 0.35, COLOR_DELAY)
        expand(Color3.fromRGB(255,215,0), 0.35, COLOR_DELAY*2)
        if currentStopType == "Range" then camRangeEffect() end
    end

    local function deactivateVFX()
        if colorEffect then colorEffect:Destroy() colorEffect = nil end
        if vignetteGui then vignetteGui:Destroy() vignetteGui = nil end
        local function shrink(col, trans, delay)
            task.wait(delay)
            local sp = makeSphere(col, trans, 20)
            sp.Size = UDim2.fromOffset(3000,3000)
            TSTween:Create(sp, TweenInfo.new(0.3), { Size = UDim2.fromOffset(0,0) }):Play()
            TSDebris:AddItem(sp, 0.4)
        end
        shrink(Color3.fromRGB(140,0,255), 0.45, 0)
        shrink(Color3.fromRGB(255,140,0), 0.35, COLOR_DELAY)
        shrink(Color3.fromRGB(255,215,0), 0.35, COLOR_DELAY*2)
    end

    local function playAnim()
        local char = tsPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if currentAnimTrack then currentAnimTrack:Stop() end
        local anim = Instance.new("Animation")
        if currentStopType == "Normal" then anim.AnimationId = ANIM_NORMAL
        elseif currentStopType == "Perfect" then anim.AnimationId = ANIM_PERFECT
        elseif currentStopType == "Range" then anim.AnimationId = ANIM_RANGE end
        currentAnimTrack = hum:LoadAnimation(anim)
        currentAnimTrack:Play()
        if currentStopType == "Normal" then currentAnimTrack:AdjustSpeed(2.5) end
        if currentStopType == "Perfect" then
            task.delay(2, function()
                if currentAnimTrack then currentAnimTrack:Stop() currentAnimTrack = nil end
            end)
        end
    end

    local function pickType()
        local r = math.random()
        if r <= 0.6 then return "Normal", MAX_TIME_NORMAL
        elseif r <= 0.9 then return "Perfect", MAX_TIME_PERFECT
        else return "Range", MAX_TIME_RANGE end
    end

    local releaseTime  -- forward declare

    local function startCooldown(duration)
        locked = true
        cooldownSoundInstance = playSound(SOUND_COOLDOWN, 3, true)
        for i = duration, 1, -1 do
            Fluent:Notify({ Title = "Time Stop Cooldown", Content = "Ready in " .. i .. "s", Duration = 1 })
            task.wait(1)
        end
        locked = false
        if cooldownSoundInstance then cooldownSoundInstance:Stop() end
        Fluent:Notify({ Title = "Time Stop", Content = "Ready!", Duration = 2 })
    end

    releaseTime = function(fromLimit)
        if not timeStopped then return end
        timeStopped = false
        if currentAnimTrack then currentAnimTrack:Stop() currentAnimTrack = nil end
        if rangeSoundInstance then rangeSoundInstance:Stop() rangeSoundInstance = nil end
        if normalSoundInstance then normalSoundInstance:Stop() normalSoundInstance = nil end
        if perfectSoundInstance then perfectSoundInstance:Stop() perfectSoundInstance = nil end
        if perfectExtraSoundInstance then perfectExtraSoundInstance:Stop() perfectExtraSoundInstance = nil end
        if currentStopType == "Normal" then playSound(SOUND_NORMAL_DEACT, 5)
        elseif currentStopType == "Perfect" then playSound(SOUND_PERFECT_DEACT, 5)
        elseif currentStopType == "Range" then playSound(SOUND_RANGE_DEACT, 5) end
        unfreezeWorld()
        deactivateVFX()
        boostSpeed(false)
        if currentStopType ~= "Range" then
            zoomCam(70, 0.25)
        else
            if tsPlayer.Character and tsPlayer.Character:FindFirstChild("HumanoidRootPart") then
                tsCamera.CFrame = CFrame.new(
                    tsPlayer.Character.HumanoidRootPart.Position + Vector3.new(0,2,6),
                    tsPlayer.Character.HumanoidRootPart.Position
                )
            end
        end
        camShake(0.25, 0.4)
        rangeCameraCFrame = nil
        Fluent:Notify({ Title = "Time Stop", Content = "▶ Time resumed", Duration = 3 })
        if fromLimit then
            task.spawn(function()
                if currentStopType == "Range" then startCooldown(COOLDOWN_RANGE)
                else startCooldown(COOLDOWN_NORMAL) end
            end)
        end
    end

    local function stopTime()
        if timeStopped or locked then
            Fluent:Notify({ Title = "Time Stop", Content = "On cooldown! Wait...", Duration = 2 })
            return
        end
        timeStopped = true
        currentStopType, maxTime = pickType()
        startTime = tick()
        if currentStopType == "Range" then rangeCameraCFrame = tsCamera.CFrame end
        if currentStopType == "Normal" then
            normalSoundInstance = playSound(SOUND_NORMAL_ACT, 5)
            explosionParticles(Color3.fromRGB(20,20,20), Color3.fromRGB(120,120,120))
            Fluent:Notify({ Title = "Time Stop", Content = "⏸ Normal Stop! (" .. MAX_TIME_NORMAL .. "s)", Duration = 3 })
        elseif currentStopType == "Perfect" then
            perfectSoundInstance = playSound(SOUND_PERFECT_ACT, 5)
            perfectExtraSoundInstance = playSound(SOUND_PERFECT_EXTRA, 5)
            explosionParticles(Color3.fromRGB(255,215,0), Color3.fromRGB(255,140,0))
            Fluent:Notify({ Title = "Time Stop", Content = "⚡ PERFECT TIME! (" .. MAX_TIME_PERFECT .. "s)", Duration = 3 })
        elseif currentStopType == "Range" then
            playSound(SOUND_RANGE_ACT, 5)
            rangeSoundInstance = playSound(SOUND_RANGE_LOOP, 1.5, true)
            explosionParticles(Color3.fromRGB(0,150,255), Color3.fromRGB(0,50,255))
            Fluent:Notify({ Title = "Time Stop", Content = "👾 RANGE MODE! (" .. MAX_TIME_RANGE .. "s)", Duration = 3 })
        end
        playAnim()
        freezeWorld()
        task.spawn(activateVFX)
        boostSpeed(true)
        if currentStopType ~= "Range" then zoomCam(55, 0.25) end
        camShake(0.35, 0.6)
        task.spawn(function()
            while timeStopped do
                if tick() - startTime >= maxTime then
                    releaseTime(true)
                    break
                end
                if currentStopType == "Range" and rangeCameraCFrame then
                    tsCamera.CFrame = rangeCameraCFrame
                end
                task.wait(0.02)
            end
        end)
    end

    -- THE BUTTON
    FunTimeStopSection:AddButton({
        Title = "⏸ Time Stop",
        Description = "Activate / Deactivate – Normal / Perfect / Range",
        Callback = function()
            if timeStopped then
                releaseTime(false)
            else
                stopTime()
            end
        end
    })
end

