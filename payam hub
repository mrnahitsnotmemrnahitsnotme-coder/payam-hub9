local function CreateESPForPlayer(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- BOX (Highlight)
    if ESP_Box then
        local existing = char:FindFirstChild("PayamESPHighlight")
        if not existing then
            local hl = Instance.new("Highlight")
            hl.Name = "PayamESPHighlight"
            hl.FillColor = ESP_Color
            hl.OutlineColor = ESP_Color
            hl.FillTransparency = 0.75
            hl.OutlineTransparency = 0.1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            table.insert(ESP_Objects, hl)
        end
    else
        local existing = char:FindFirstChild("PayamESPHighlight")
        if existing then existing:Destroy() end
    end

    -- BILLBOARD (Name + Health + Distance)
    local existingBB = hrp:FindFirstChild("PayamESPBillboard")
    if existingBB then existingBB:Destroy() end

    if ESP_Name or ESP_Health or ESP_Distance then
        local bb = Instance.new("BillboardGui")
        bb.Name = "PayamESPBillboard"
        bb.Adornee = hrp
        bb.Size = UDim2.new(0, 200, 0, 70)
        bb.StudsOffset = Vector3.new(0, 3.5, 0)
        bb.AlwaysOnTop = true
        bb.Parent = hrp

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.Parent = bb

        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.Parent = frame

        local function MakeLabel(text, color, order)
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 20)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = color
            lbl.TextStrokeTransparency = 0.4
            lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 14
            lbl.LayoutOrder = order
            lbl.Parent = frame
            return lbl
        end

        if ESP_Name then
            local nameLabel = MakeLabel(player.Name, ESP_Color, 1)
            table.insert(ESP_Objects, nameLabel)
        end

        if ESP_Health then
            local hp = math.floor(hum.Health)
            local maxHp = math.floor(hum.MaxHealth)
            local healthLabel = MakeLabel("HP: " .. hp .. "/" .. maxHp, Color3.fromRGB(80, 255, 120), 2)
            
            -- live update health
            local conn = RunService.Heartbeat:Connect(function()
                if not healthLabel or not healthLabel.Parent then return end
                local h = math.floor(hum.Health)
                local mh = math.floor(hum.MaxHealth)
                healthLabel.Text = "HP: " .. h .. "/" .. mh
                local ratio = math.clamp(h / mh, 0, 1)
                healthLabel.TextColor3 = Color3.fromRGB(
                    math.floor((1 - ratio) * 255),
                    math.floor(ratio * 255),
                    50
                )
            end)
            table.insert(ESP_Objects, conn)
            table.insert(ESP_Objects, healthLabel)
        end

        if ESP_Distance then
            local distLabel = MakeLabel("? studs", Color3.fromRGB(200, 200, 255), 3)
            local conn = RunService.Heartbeat:Connect(function()
                if not distLabel or not distLabel.Parent then return end
                local myChar = LocalPlayer.Character
                local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHRP and hrp then
                    local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
                    distLabel.Text = dist .. " studs"
                end
            end)
            table.insert(ESP_Objects, conn)
            table.insert(ESP_Objects, distLabel)
        end

        table.insert(ESP_Objects, bb)
    end

    -- TRACERS
    if ESP_Tracers then
        local existingTracer = game.CoreGui:FindFirstChild("PayamTracer_" .. player.Name)
        if existingTracer then existingTracer:Destroy() end

        local tracerGui = Instance.new("ScreenGui")
        tracerGui.Name = "PayamTracer_" .. player.Name
        tracerGui.ResetOnSpawn = false
        tracerGui.IgnoreGuiInset = true
        tracerGui.Parent = game.CoreGui

        local line = Instance.new("Frame")
        line.BackgroundColor3 = ESP_Color
        line.BorderSizePixel = 0
        line.AnchorPoint = Vector2.new(0.5, 0)
        line.Parent = tracerGui

        local conn = RunService.RenderStepped:Connect(function()
            if not ESP_Tracers or not ESP_Enabled then tracerGui:Destroy() return end
            if not hrp or not hrp.Parent then tracerGui:Destroy() return end

            local cam = workspace.CurrentCamera
            local screenSize = cam.ViewportSize
            local startPos = Vector2.new(screenSize.X / 2, screenSize.Y)
            local targetPos3D, onScreen = cam:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local targetPos = Vector2.new(targetPos3D.X, targetPos3D.Y)
                local diff = targetPos - startPos
                local length = diff.Magnitude
                local angle = math.atan2(diff.Y, diff.X)
                line.Size = UDim2.new(0, length, 0, 1)
                line.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
                line.Rotation = math.deg(angle)
                line.Visible = true
            else
                line.Visible = false
            end
        end)

        table.insert(ESP_Objects, conn)
        table.insert(ESP_Objects, tracerGui)
    end
end

local function RefreshESP()
    ClearESP()
    if not ESP_Enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Character then
