                                                            botHRP.Velocity = Vector3.new(90000, 900000, 90000)
                                                            botHRP.RotVelocity = Vector3.new(900000, 900000, 900000)
                                                            RunService.Heartbeat:Wait()

                                                            botHRP.CFrame = CFrame.new(theirHRP.Position) * CFrame.new(0, -1.5, -theirHum.WalkSpeed)
                                                            botHRP.Velocity = Vector3.new(90000, 900000, 90000)
                                                            RunService.Heartbeat:Wait()
                                                        end
                                                    end

                                                    bv:Destroy()
                                                    botHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                                                    workspace.FallenPartsDestroyHeight = oldFPDH

                                                    for i = 1, 5 do
                                                        botHRP.CFrame = oldCFrame * CFrame.new(0, 0.5, 0)
                                                        botHum:ChangeState(Enum.HumanoidStateType.GettingUp)
                                                        for _, part in pairs(botChar:GetChildren()) do
                                                            if part:IsA("BasePart") then
                                                                part.Velocity = Vector3.zero
                                                                part.RotVelocity = Vector3.zero
                                                            end
                                                        end
                                                        RunService.Heartbeat:Wait()
                                                    end
                                                end)
                                            end)
                                        end
                                    end
                                end
                            end
                        end)

                        Fluent:Notify({ Title = "Fling Aura", Content = "✅ ON – " .. flingAuraRadius .. " studs", Duration = 4 })
                        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
