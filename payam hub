        autoTpConnection = nil
    end

    if v then
        if not savedPosition then
            Fluent:Notify({
                Title = "Auto Teleport",
                Content = "Save a position first!",
                Duration = 3
            })
            autoTpEnabled = false
            return
        end

        local lastTp = tick()
        autoTpConnection = RunService.Heartbeat:Connect(function()
            if not autoTpEnabled then return end
            if tick() - lastTp >= autoTpInterval then
                lastTp = tick()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and savedPosition then
                    hrp.CFrame = savedPosition
                end
            end
        end)

        Fluent:Notify({
            Title = "Auto Teleport",
            Content = "ON – every " .. autoTpInterval .. "s",
            Duration = 3
        })
    else
        Fluent:Notify({
            Title = "Auto Teleport",
            Content = "OFF",
            Duration = 3
        })
    end
end)

