------------------------------------------------
-- ANTI AFK (CLEAN + FIXED)
------------------------------------------------

local AntiAFKEnabled = false
local AntiAFKConnection = nil
local ChatCooldown = 0
local MoveCooldown = 0

local WalkOffsets = {
    Vector3.new(8,0,0),
    Vector3.new(-8,0,0),
    Vector3.new(0,0,8),
    Vector3.new(0,0,-8),
}

AntiAFKSection:AddToggle("AntiAFKToggle", {
    Title = "Anti AFK (Smart)",
    Default = false
}):OnChanged(function(v)
    AntiAFKEnabled = v

    -- STOP old loop
    if AntiAFKConnection then
        AntiAFKConnection:Disconnect()
        AntiAFKConnection = nil
    end

    if v then
        AntiAFKConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end

            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp then return end

            local now = tick()

            ------------------------------------------------
            -- MOVE (human-like)
            ------------------------------------------------
            if now >= MoveCooldown then
                MoveCooldown = now + math.random(1,3)

                local offset = WalkOffsets[math.random(1,#WalkOffsets)]
                hum:MoveTo(hrp.Position + offset)
            end

            ------------------------------------------------
            -- RANDOM JUMP
            ------------------------------------------------
            if math.random(1, 120) == 1 then
                hum.Jump = true
            end

            ------------------------------------------------
            -- SAFE CHAT (OPTIONAL)
            ------------------------------------------------
            if now >= ChatCooldown then
                ChatCooldown = now + math.random(60,120)

                local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                if channel then
                    local messages = {
                        "im here",
                        "afk a bit",
                        "just chilling",
                        "lol",
                        "anyone here?"
                    }

                    local msg
                    if math.random(1,6) == 1 then
                        msg = "donate payam 10"
                    else
                        msg = messages[math.random(1,#messages)]
                    end

                    pcall(function()
                        channel:SendAsync(msg)
                    end)
                end
            end
        end)
    end
end)

