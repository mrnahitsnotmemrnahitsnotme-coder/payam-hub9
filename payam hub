local function ToggleExecutor()
    if not executorBuilt or not executorGui or not executorGui.Parent then
        BuildExecutorGUI()
        executorGui.Enabled = true
        execIsVisible = true

        local frame = executorGui:FindFirstChild("MainFrame")
        if frame then
            local W, H = 680, 560
            frame.Size     = UDim2.fromOffset(W, 0)
            frame.Position = UDim2.new(0.5, -W/2, 0.5, 0)
            TweenService:Create(frame,
                TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Size = UDim2.fromOffset(W, H),
                  Position = UDim2.new(0.5, -W/2, 0.5, -H/2) }
            ):Play()
        end
        return
    end

    local frame = executorGui:FindFirstChild("MainFrame")
    local W, H  = 680, 560

    if execIsVisible then
        -- hide with shrink animation
        if frame then
            TweenService:Create(frame,
                TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Size = UDim2.fromOffset(W, 0),
                  Position = UDim2.new(0.5, -W/2, 0.5, 0) }
            ):Play()
            task.delay(0.24, function()
                executorGui.Enabled = false
                if frame and frame.Parent then
                    frame.Size     = UDim2.fromOffset(W, H)
                    frame.Position = UDim2.new(0.5, -W/2, 0.5, -H/2)
                end
            end)
        else
            executorGui.Enabled = false
        end
        execIsVisible = false
    else
        -- show with pop animation
        executorGui.Enabled = true
        if frame then
            frame.Size     = UDim2.fromOffset(W, 0)
            frame.Position = UDim2.new(0.5, -W/2, 0.5, 0)
            TweenService:Create(frame,
                TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { Size = UDim2.fromOffset(W, H),
                  Position = UDim2.new(0.5, -W/2, 0.5, -H/2) }
            ):Play()
        end
        execIsVisible = true
    end
end

